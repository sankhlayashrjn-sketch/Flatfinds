# Copy this file to .env.local and fill in real values for local dev.
# In Vercel, set these under Project Settings -> Environment Variables instead.

# From a Supabase project (supabase.com -> New project, it's free):
# Project Settings -> API -> Project URL / anon public key.
# Before using the app, also run supabase/schema.sql once in that project's
# SQL editor to create the tables, RLS policies, and realtime publication.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
